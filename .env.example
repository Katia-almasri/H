# Application
APP_NAME=Harvest
DEBUG=True
API_VERSION=v1

# Database
DATABASE_URL=postgresql+psycopg://harvest_user:harvest_password@localhost:5433/harvest_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Configuration
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Generate RSA keys with:
# openssl genrsa -out private_key.pem 2048
# openssl rsa -in private_key.pem -pubout -out public_key.pem
JWT_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END RSA PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nYOUR_PUBLIC_KEY_HERE\n-----END PUBLIC KEY-----

# Password Hashing (Argon2id)
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=2

# Security
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
COOKIE_SECURE=False
COOKIE_HTTPONLY=True
COOKIE_SAMESITE=strict

# Rate Limiting
LOGIN_RATE_LIMIT=10/minute
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_DURATION_MINUTES=30

# AWS Configuration (for production)
AWS_REGION=me-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=noreply@shard.ae

# Multi-tenancy
DEFAULT_TENANT_ID=harvest-uae
